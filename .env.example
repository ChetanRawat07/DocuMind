# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Application (read by apps/api; PORT is also used by the web dev proxy)
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# json (structured, for deployments) | pretty (readable, for local work)
LOG_FORMAT=pretty
# HTTP port of the API process. Hosting platforms such as Render inject PORT.
PORT=3000
# Comma-separated browser origins allowed to call the API (scheme://host[:port], no trailing slash).
# Empty disables cross-origin access. Local dev uses the Vite proxy, so same-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# How long the worker waits after finding no work before polling again.
WORKER_POLL_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Database (read by apps/api: API, worker, migrations, seed)
# ---------------------------------------------------------------------------
# Must match the POSTGRES_* values below for local development.
DATABASE_URL=postgres://documind:documind_local_dev_only@localhost:5432/documind
# Maximum connections per process (API and worker each have their own pool).
DATABASE_POOL_MAX=10
# Server-side limit for a single statement.
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Database used by the integration tests. It is dropped and recreated on every
# test run, so its name must end in _test.
TEST_DATABASE_URL=postgres://documind:documind_local_dev_only@localhost:5432/documind_test

# ---------------------------------------------------------------------------
# Supabase Auth (see README "Authentication setup")
# ---------------------------------------------------------------------------
# Project URL: Supabase Dashboard -> Project Settings -> API. The API derives
# the token issuer (<url>/auth/v1) and public signing keys (JWKS) from it.
# Not a secret. The project must use asymmetric JWT signing keys (ES256/RS256).
SUPABASE_URL=https://your-project-ref.supabase.co
# Browser configuration. Every VITE_* value is bundled into the public web app:
# never put a secret here (no service_role / secret key, no database password).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Designed to be public.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Object storage for uploaded documents (read by apps/api)
# ---------------------------------------------------------------------------
# filesystem (development and tests only; refused in production) | s3 (Cloudflare R2)
STORAGE_DRIVER=filesystem
# Folder for the filesystem driver, relative to the API's working directory
# (apps/api when started with npm). Git-ignored.
STORAGE_FILESYSTEM_ROOT=.data/storage
# S3-compatible settings, required when STORAGE_DRIVER=s3. For R2:
# endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, and an
# API token scoped to Object Read & Write on this one bucket. The bucket must be
# private (no public access, no r2.dev URL). The secret stays on the server:
# never put it in a VITE_* variable.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=documind-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Local infrastructure (read by docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_local_dev_only
POSTGRES_DB=documind
POSTGRES_PORT=5432
